<Page
    x:Class="MuurMusic.App.Views.EqPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Background="Transparent">
    <ScrollViewer>
        <Grid Margin="24,16,24,120" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Equalizer" Style="{StaticResource MuurPageTitle}" VerticalAlignment="Center" />
                <ToggleSwitch HorizontalAlignment="Right" Header="Enabled" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" AutomationProperties.Name="Equalizer enabled" />
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource MuurCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Preset:" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.PresetNames, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                              MinWidth="220" AutomationProperties.Name="EQ preset" />
                    <Button Click="Save_Click" AutomationProperties.Name="Save preset">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="13" /><TextBlock Text="Save" /></StackPanel>
                    </Button>
                    <Button Click="Rename_Click" IsEnabled="{x:Bind ViewModel.CanModifyPreset, Mode=OneWay}" AutomationProperties.Name="Rename preset">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Rename" /></StackPanel>
                    </Button>
                    <Button Click="Delete_Click" IsEnabled="{x:Bind ViewModel.CanModifyPreset, Mode=OneWay}" AutomationProperties.Name="Delete preset">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete" /></StackPanel>
                    </Button>
                    <Button Click="Import_Click" AutomationProperties.Name="Import presets"><TextBlock Text="Import" /></Button>
                    <Button Click="Export_Click" AutomationProperties.Name="Export presets"><TextBlock Text="Export" /></Button>
                    <Button Click="Reset_Click" AutomationProperties.Name="Reset to flat"><TextBlock Text="Flat" /></Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource MuurCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Preamp -->
                    <StackPanel Spacing="4" Width="64">
                        <TextBlock Text="Preamp" Style="{StaticResource MuurSecondaryText}" FontSize="11" HorizontalAlignment="Center" />
                        <Slider Orientation="Vertical" Height="240" HorizontalAlignment="Center"
                                Minimum="-12" Maximum="12" StepFrequency="0.5" TickFrequency="3"
                                Value="{x:Bind ViewModel.Preamp, Mode=TwoWay}"
                                AutomationProperties.Name="Preamp" />
                        <TextBlock Text="{x:Bind ViewModel.Preamp, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Bands, Mode=OneWay}" HorizontalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="26" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vms:EqBandItem">
                                <StackPanel Spacing="4" Width="48">
                                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" FontSize="10" HorizontalAlignment="Center" />
                                    <Slider Orientation="Vertical" Height="240" HorizontalAlignment="Center"
                                            Minimum="-12" Maximum="12" StepFrequency="0.5" TickFrequency="3"
                                            Value="{x:Bind Value, Mode=TwoWay}"
                                            AutomationProperties.Name="{x:Bind Label}" />
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource MuurSecondaryText}" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource MuurCardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Output level" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <ProgressBar Value="{x:Bind ViewModel.PeakLeft, Mode=OneWay}" Minimum="0" Maximum="1" Width="220" AutomationProperties.Name="Left peak" />
                        <ProgressBar Value="{x:Bind ViewModel.PeakRight, Mode=OneWay}" Minimum="0" Maximum="1" Width="220" AutomationProperties.Name="Right peak" />
                    </StackPanel>
                    <TextBlock Text="Gains apply live to whatever is playing. Preamp plus band boosts are capped at +12 dB." Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
