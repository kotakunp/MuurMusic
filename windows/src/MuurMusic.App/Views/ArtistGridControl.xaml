<UserControl
    x:Class="MuurMusic.App.Views.ArtistGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls">
    <Grid>
        <GridView x:Name="Grid"
                  ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="Grid_ItemClick"
                  SelectionMode="None" Padding="0,4,0,120"
                  AutomationProperties.Name="Artists">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vms:ArtistCardViewModel">
                    <Grid Width="160" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Width="160" Height="160">
                            <Border CornerRadius="80" Background="{ThemeResource MuurHighlightBrush}">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ArtworkPath, Mode=OneTime, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="320" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="0" Padding="6,0">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" TextAlignment="Center" />
                            <TextBlock Text="{x:Bind SubText}" Style="{StaticResource MuurSecondaryText}" FontSize="11" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Image Source="/Assets/empty-library.png" Width="240" />
            <TextBlock Text="Nobody here but us cats" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
