<Page
    x:Class="MuurMusic.App.Views.SmartPlaylistEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Background="Transparent">
    <ScrollViewer Padding="0,0,0,120">
        <StackPanel Margin="24,16,24,0" Spacing="12" MaxWidth="820">
            <TextBlock Text="Smart playlist" Style="{StaticResource MuurPageTitle}" />
            <Border Style="{StaticResource MuurCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Playlist name" />
                    <ComboBox Grid.Column="1" Header="Match" x:Name="MatchBox" SelectedIndex="{x:Bind ViewModel.MatchIndex, Mode=TwoWay}" AutomationProperties.Name="Match mode">
                        <ComboBoxItem Content="All rules" />
                        <ComboBoxItem Content="Any rule" />
                    </ComboBox>
                    <NumberBox Grid.Column="2" Header="Limit (0 = all)" Value="{x:Bind ViewModel.Limit, Mode=TwoWay}" Minimum="0" Maximum="100000" Width="150" AutomationProperties.Name="Track limit" />
                </Grid>
            </Border>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vms:SmartRuleItem">
                        <Border Style="{StaticResource MuurCardStyle}" Padding="12">
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{x:Bind FieldsList}" SelectedItem="{x:Bind Field, Mode=TwoWay}" AutomationProperties.Name="Rule field" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind OpsList}" SelectedItem="{x:Bind Op, Mode=TwoWay}" AutomationProperties.Name="Rule operator" />
                                <TextBox Grid.Column="2" PlaceholderText="Value" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rule value" />
                                <TextBox Grid.Column="3" PlaceholderText="And" Text="{x:Bind Value2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{x:Bind NeedsValue2, Mode=OneWay}" AutomationProperties.Name="Second value" />
                                <Button Grid.Column="4" Style="{StaticResource MuurIconButtonStyle}" Command="{x:Bind RemoveCommandProxy}" CommandParameter="{x:Bind}" ToolTipService.ToolTip="Remove rule" AutomationProperties.Name="Remove rule">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="AddRule_Click" AutomationProperties.Name="Add rule">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Add rule" /></StackPanel>
                </Button>
                <ComboBox x:Name="SortBox" Header="Sort" Width="220" SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="Sort order">
                    <ComboBoxItem Content="Default order" Tag="" />
                    <ComboBoxItem Content="Title" Tag="title" />
                    <ComboBoxItem Content="Artist" Tag="artist" />
                    <ComboBoxItem Content="Album" Tag="album" />
                    <ComboBoxItem Content="Recently added" Tag="-dateAdded" />
                    <ComboBoxItem Content="Recently played" Tag="-lastPlayed" />
                    <ComboBoxItem Content="Most played" Tag="-playCount" />
                    <ComboBoxItem Content="Highest rated" Tag="-rating" />
                    <ComboBoxItem Content="Longest" Tag="-duration" />
                    <ComboBoxItem Content="Random" Tag="random" />
                </ComboBox>
            </StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsCounting, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind ViewModel.LiveCount, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource MuurAccentButton}" Click="Save_Click" IsEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}" AutomationProperties.Name="Save smart playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="13" /><TextBlock Text="Save playlist" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
