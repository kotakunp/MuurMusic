<Page
    x:Class="MuurMusic.App.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MuurMusic.App.Views"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Genres" Style="{StaticResource MuurPageTitle}" />
        <views:NameCountListControl x:Name="List" Grid.Row="1" />
    </Grid>
</Page>
