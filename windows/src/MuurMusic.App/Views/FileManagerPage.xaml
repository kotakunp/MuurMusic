<Page
    x:Class="MuurMusic.App.Views.FileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MuurHeaderButton}" Click="Up_Click"
                    IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" AutomationProperties.Name="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource MuurPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.CurrentFolderName, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Click="PlayFolder_Click" AutomationProperties.Name="Play folder">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                </Button>
                <Button Click="NewFolder_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" ToolTipService.ToolTip="New folder" AutomationProperties.Name="New folder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                </Button>
                <Button Click="Upload_Click" IsEnabled="{x:Bind ViewModel.CanUpload, Mode=OneWay}" ToolTipService.ToolTip="Upload files here" AutomationProperties.Name="Upload files">
                    <FontIcon Glyph="&#xE898;" FontSize="14" />
                </Button>
                <Button Click="AddToLibrary_Click" IsEnabled="{x:Bind ViewModel.IsLocal, Mode=OneWay}" ToolTipService.ToolTip="Add this folder to the library" AutomationProperties.Name="Add folder to library">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource MuurIconButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsClosable="False" />
        <Grid Grid.Row="2">
            <ListView x:Name="List"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True" ItemClick="List_ItemClick"
                      RightTapped="List_RightTapped"
                      SelectionChanged="List_SelectionChanged"
                      Padding="0,4,0,16"
                      AutomationProperties.Name="Files">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vms:BrowserItemViewModel">
                        <Grid ColumnSpacing="10" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource MuurAccentSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Subtitle}" Style="{StaticResource MuurSecondaryText}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="/Assets/empty-library.png" Width="220" />
                <TextBlock Text="This folder is empty" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
        </Grid>
        <!-- Selection action bar -->
        <Border Grid.Row="3" Style="{StaticResource MuurCardStyle}" Margin="0,0,0,10"
                Visibility="{x:Bind HasSelection, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="SelectionText" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                <Button Click="PlaySelection_Click" AutomationProperties.Name="Play selection">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                </Button>
                <Button Click="RenameSelection_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="Rename">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Rename" /></StackPanel>
                </Button>
                <Button Click="MoveSelection_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="Move selection">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8DE;" FontSize="13" /><TextBlock Text="Move" /></StackPanel>
                </Button>
                <Button Click="CopySelection_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="Copy selection">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy" /></StackPanel>
                </Button>
                <Button Click="ExportSelection_Click" AutomationProperties.Name="Export selection">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" FontSize="13" /><TextBlock Text="Export" /></StackPanel>
                </Button>
                <Button Click="DeleteSelection_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" AutomationProperties.Name="Delete selection">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
