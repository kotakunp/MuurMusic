<Page
    x:Class="MuurMusic.App.Views.TrackListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource MuurPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MuurAccentButton}" Click="Play_Click" AutomationProperties.Name="Play all">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
            </Button>
        </Grid>
        <controls:TrackRowsControl Grid.Row="1" x:Name="TrackRows" PlayRequested="TrackRows_PlayRequested" />
    </Grid>
</Page>
