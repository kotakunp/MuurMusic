<UserControl
    x:Class="MuurMusic.App.Views.NameCountListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls">
    <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="List_ItemClick"
                  SelectionMode="None" Padding="0,4,0,120"
                  AutomationProperties.Name="List">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vms:NameCountItem">
                    <Grid ColumnSpacing="10" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource MuurHighlightBrush}" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource MuurAccentSecondaryBrush}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SubText}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Image Source="/Assets/empty-library.png" Width="240" />
            <TextBlock Text="Nothing here yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
