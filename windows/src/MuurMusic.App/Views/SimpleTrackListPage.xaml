<Page
    x:Class="MuurMusic.App.Views.SimpleTrackListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MuurMusic.Core.Models"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource MuurPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <Button Click="ClearHistory_Click" Visibility="{x:Bind ViewModel.IsHistory, Mode=OneWay}" AutomationProperties.Name="Clear history"><TextBlock Text="Clear history" /></Button>
                <Button Style="{StaticResource MuurAccentButton}" Click="PlayAll_Click" Visibility="{x:Bind ViewModel.IsHistory, Mode=OneWay, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Play all">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play all" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <!-- History rows -->
            <ListView ItemsSource="{x:Bind ViewModel.HistoryEntries, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.IsHistory, Mode=OneWay}"
                      IsItemClickEnabled="True" ItemClick="History_ItemClick"
                      Padding="0,4,0,120" AutomationProperties.Name="History">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlayHistoryEntry">
                        <Grid ColumnSpacing="10" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Artist}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Completed, Mode=OneTime, Converter={StaticResource BoolToYesNo}}" Style="{StaticResource MuurSecondaryText}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind PlayedAt, Mode=OneTime, Converter={StaticResource DateTime}}" Style="{StaticResource MuurSecondaryText}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Track rows -->
            <controls:TrackRowsControl x:Name="TrackRows" PlayRequested="TrackRows_PlayRequested"
                                       Visibility="{x:Bind ViewModel.IsHistory, Mode=OneWay, Converter={StaticResource InverseBool}}" />
            <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="/Assets/empty-library.png" Width="240" />
                <TextBlock Text="Nothing here yet" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
