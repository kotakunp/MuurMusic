<Page
    x:Class="MuurMusic.App.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <ScrollViewer Padding="0,0,0,120">
        <Grid Margin="24,16,24,0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="160" Height="160" CornerRadius="80" Background="{ThemeResource MuurHighlightBrush}">
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <BitmapImage UriSource="{x:Bind ViewModel.ArtworkPath, Mode=OneWay, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="320" />
                        </Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="Artist" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuurAccentTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Style="{StaticResource MuurAccentButton}" Click="Play_Click" AutomationProperties.Name="Play artist">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                        </Button>
                        <Button Click="Shuffle_Click" AutomationProperties.Name="Shuffle artist">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B1;" FontSize="13" /><TextBlock Text="Shuffle" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay}">
                <TextBlock Text="Albums" FontSize="18" FontWeight="SemiBold" />
                <GridView ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="Album_ItemClick" SelectionMode="None"
                          ScrollViewer.VerticalScrollMode="Disabled" MaxHeight="260"
                          AutomationProperties.Name="Artist albums">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vms:AlbumCardViewModel">
                            <Grid Width="150" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border CornerRadius="{StaticResource MuurRadiusArtwork}" Background="{ThemeResource MuurHighlightBrush}">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ArtworkPath, Mode=OneTime, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="300" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Row="1" Padding="2,0">
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="Tracks" FontSize="18" FontWeight="SemiBold" />
                <controls:TrackRowsControl x:Name="TrackRows" PlayRequested="TrackRows_PlayRequested" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
