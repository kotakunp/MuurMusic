<Page
    x:Class="MuurMusic.App.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuurMusic.App.Controls"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Albums" Style="{StaticResource MuurPageTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="SortBox" Width="170" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="Sort albums">
                    <ComboBoxItem Content="Name" Tag="Name" />
                    <ComboBoxItem Content="Artist" Tag="Artist" />
                    <ComboBoxItem Content="Year" Tag="Year" />
                    <ComboBoxItem Content="Recently added" Tag="DateAdded" />
                    <ComboBoxItem Content="Most played" Tag="PlayCount" />
                    <ComboBoxItem Content="Duration" Tag="Duration" />
                </ComboBox>
                <Button Click="Rescan_Click" AutomationProperties.Name="Rescan library">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE777;" FontSize="13" /><TextBlock Text="Rescan" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <TextBox Grid.Row="1" x:Name="FilterBox" PlaceholderText="Filter albums&#x2026;" TextChanged="FilterBox_TextChanged" MaxWidth="360" HorizontalAlignment="Left" />
        <Grid Grid.Row="2">
            <GridView x:Name="AlbumGrid"
                      ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                      IsItemClickEnabled="True" ItemClick="AlbumGrid_ItemClick"
                      RightTapped="AlbumGrid_RightTapped"
                      SelectionMode="None" Padding="0,4,0,120"
                      AutomationProperties.Name="Albums">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vms:AlbumCardViewModel">
                        <Grid Width="180" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="{StaticResource MuurRadiusArtwork}" Background="{ThemeResource MuurHighlightBrush}">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ArtworkPath, Mode=OneTime, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="360" />
                                    </Image.Source>
                                </Image>
                            </Border>
                            <Border Grid.Row="0" Background="{ThemeResource MuurAccentBrush}" CornerRadius="4" Padding="5,1"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                    Visibility="{x:Bind IsHiRes, Mode=OneTime}">
                                <TextBlock Text="Hi-Res" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource MuurBackgroundBrush}" />
                            </Border>
                            <StackPanel Grid.Row="1" Spacing="0" Padding="4,0">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind Artist}" Style="{StaticResource MuurSecondaryText}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind SubText}" Style="{StaticResource MuurSecondaryText}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,0,0,120">
                <Image Source="/Assets/empty-library.png" Width="280" />
                <TextBlock Text="No albums yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add a music folder from the Songs page and your albums appear here." Style="{StaticResource MuurSecondaryText}" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
