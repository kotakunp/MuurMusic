<Page
    x:Class="MuurMusic.App.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Playlists" Style="{StaticResource MuurPageTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Style="{StaticResource MuurAccentButton}" Click="NewPlaylist_Click" AutomationProperties.Name="New playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="New playlist" /></StackPanel>
                </Button>
                <Button Click="NewSmart_Click" AutomationProperties.Name="New smart playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE945;" FontSize="13" /><TextBlock Text="Smart playlist" /></StackPanel>
                </Button>
                <Button Click="Import_Click" AutomationProperties.Name="Import playlist"><TextBlock Text="Import" /></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <GridView x:Name="Grid"
                      ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      IsItemClickEnabled="True" ItemClick="Grid_ItemClick"
                      RightTapped="Grid_RightTapped"
                      SelectionMode="None" Padding="0,4,0,120"
                      AutomationProperties.Name="Playlists">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vms:PlaylistCardViewModel">
                        <Grid Width="180" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="{StaticResource MuurRadiusArtwork}" Background="{ThemeResource MuurHighlightBrush}">
                                <Grid>
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ArtworkPath, Mode=OneTime, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="360" />
                                        </Image.Source>
                                    </Image>
                                    <FontIcon Glyph="&#xE945;" FontSize="26" Foreground="{ThemeResource MuurAccentBrush}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                              Visibility="{x:Bind IsSmart, Mode=OneTime}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Padding="4,0">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind SubText}" Style="{StaticResource MuurSecondaryText}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="/Assets/empty-library.png" Width="240" />
                <TextBlock Text="No playlists yet" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Right-click any track or album to start one." Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
