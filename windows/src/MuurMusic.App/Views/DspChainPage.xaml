<Page
    x:Class="MuurMusic.App.Views.DspChainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Background="Transparent">
    <Grid Margin="24,16,24,120" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DSP Chain" Style="{StaticResource MuurPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
            <ToggleSwitch HorizontalAlignment="Right" Header="Chain enabled" IsOn="{x:Bind ViewModel.ChainEnabled, Mode=TwoWay}" AutomationProperties.Name="DSP chain enabled" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource MuurCardStyle}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="AddBox" PlaceholderText="Add a processor&#x2026;" MinWidth="200"
                          ItemsSource="{x:Bind ViewModel.AvailableTypes, Mode=OneTime}"
                          DisplayMemberPath="Label" SelectionChanged="AddBox_SelectionChanged"
                          AutomationProperties.Name="Add DSP node" />
                <Button Click="Clear_Click" AutomationProperties.Name="Clear chain"><TextBlock Text="Clear" /></Button>
                <Border Width="1" Background="{ThemeResource MuurHighlightBrush}" Margin="6,4" />
                <ComboBox ItemsSource="{x:Bind ViewModel.SavedChainNames, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSavedChain, Mode=TwoWay}"
                          PlaceholderText="Saved chains&#x2026;" MinWidth="170" AutomationProperties.Name="Saved chains" />
                <Button Click="LoadSaved_Click" AutomationProperties.Name="Load saved chain"><FontIcon Glyph="&#xE8E5;" FontSize="13" /></Button>
                <Button Click="SaveAs_Click" AutomationProperties.Name="Save chain as"><FontIcon Glyph="&#xE74E;" FontSize="13" /></Button>
                <Button Click="DeleteSaved_Click" AutomationProperties.Name="Delete saved chain"><FontIcon Glyph="&#xE74D;" FontSize="13" /></Button>
                <Button Click="Import_Click" AutomationProperties.Name="Import chain"><TextBlock Text="Import" /></Button>
                <Button Click="Export_Click" AutomationProperties.Name="Export chain"><TextBlock Text="Export" /></Button>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vms:DspNodeItem">
                        <Border Style="{StaticResource MuurCardStyle}" Padding="14">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="Node enabled" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <Button Style="{StaticResource MuurIconButtonStyle}" Command="{x:Bind MoveUpCommand}" CommandParameter="{x:Bind}" ToolTipService.ToolTip="Move up" AutomationProperties.Name="Move up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource MuurIconButtonStyle}" Command="{x:Bind MoveDownCommand}" CommandParameter="{x:Bind}" ToolTipService.ToolTip="Move down" AutomationProperties.Name="Move down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource MuurIconButtonStyle}" Command="{x:Bind RemoveCommand}" CommandParameter="{x:Bind}" ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove node">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Params}" Margin="34,0,0,0">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vms:DspParamItem">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1000" StepFrequency="1"
                                                        Value="{x:Bind Slider, Mode=TwoWay}"
                                                        IsEnabled="{x:Bind IsEffectivelyEnabled}"
                                                        AutomationProperties.Name="{x:Bind Label}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayValue, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
