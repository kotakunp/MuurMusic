<Page
    x:Class="MuurMusic.App.Views.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuurMusic.App.Controls"
    xmlns:models="using:MuurMusic.Core.Models"
    Background="Transparent">

    <Grid Margin="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Songs" Style="{StaticResource MuurPageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <Button Content="Play all" Command="{x:Bind ViewModel.PlayAllCommand}" AutomationProperties.Name="Play all songs">
                    <Button.Resources><Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}" /></Button.Resources>
                </Button>
                <Button Click="AddFolder_Click" AutomationProperties.Name="Add music folder">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8F4;" FontSize="13" /><TextBlock Text="Add folder" /></StackPanel>
                </Button>
                <Button x:Name="RescanButton" Command="{x:Bind ViewModel.RescanCommand}" AutomationProperties.Name="Rescan library">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE777;" FontSize="13" /><TextBlock Text="Rescan" /></StackPanel>
                </Button>
                <Button x:Name="CancelScanButton" Content="Cancel" Command="{x:Bind ViewModel.CancelScanCommand}" Visibility="Collapsed" AutomationProperties.Name="Cancel scan" />
            </StackPanel>
        </Grid>

        <!-- Scan progress -->
        <Grid Grid.Row="1" x:Name="ScanBar" Visibility="Collapsed" ColumnSpacing="10" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Value="{x:Bind ViewModel.ScanFraction, Mode=OneWay}" Minimum="0" Maximum="1" VerticalAlignment="Center" Height="4" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
        </Grid>

        <!-- Column headers (click to sort) -->
        <Grid Grid.Row="2" Margin="0,4,0,0" Padding="12,0" ColumnSpacing="8" BorderBrush="{ThemeResource MuurHighlightBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HeaderTitle" Grid.Column="1" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Title" Content="Title" AutomationProperties.Name="Sort by title" />
            <Button Grid.Column="2" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Artist" Content="Artist" />
            <Button Grid.Column="3" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Album" Content="Album" />
            <Button Grid.Column="4" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Duration" Content="Time" HorizontalContentAlignment="Right" />
            <Button Grid.Column="5" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Genre" Content="Genre" />
            <Button Grid.Column="6" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Year" Content="Year" />
            <Button Grid.Column="7" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Rating" Content="Rating" />
            <Button Grid.Column="8" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Bitrate" Content="Quality" />
            <Button Grid.Column="9" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="PlayCount" Content="Plays" />
            <Button Grid.Column="10" Style="{StaticResource MuurHeaderButton}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="DateAdded" Content="Added" />
        </Grid>

        <!-- Track list -->
        <Grid Grid.Row="3">
            <ListView x:Name="TrackList"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      DoubleTapped="TrackList_DoubleTapped"
                      RightTapped="TrackList_RightTapped"
                      ContainerContentChanging="TrackList_ContainerContentChanging"
                      Padding="0,4,0,120"
                      AutomationProperties.Name="Songs">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource MuurHighlightBrush}" VerticalAlignment="Center">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind ArtworkHash, Mode=OneTime, Converter={StaticResource ArtworkThumb}}" DecodePixelWidth="64" />
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Style="{StaticResource MuurSecondaryText}" FontSize="11" Visibility="{x:Bind IsCueTrack, Mode=OneTime}" Text="CUE track" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayArtist}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DisplayAlbum}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Grid.Column="4" Text="{x:Bind DurationMs, Converter={StaticResource Duration}}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{x:Bind Genre}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Grid.Column="6" Text="{x:Bind Year, FallbackValue=''}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="{x:Bind Rating, Converter={StaticResource RatingStars}}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource MuurAccentTextBrush}" />
                            <Border Grid.Column="8" Background="{ThemeResource MuurHighlightBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind QualityBadge}" FontSize="10" Foreground="{ThemeResource MuurAccentTextBrush}" />
                            </Border>
                            <TextBlock Grid.Column="9" Text="{x:Bind PlayCount}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="10" Text="{x:Bind DateAdded, Converter={StaticResource DateTime}}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Loading / empty states -->
            <controls:PawLoadingIndicator x:Name="LoadingPaws" HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,0,0,120">
                <Image Source="/Assets/empty-library.png" Width="280" />
                <TextBlock Text="No music here yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Point MuurMusic at your music folder and the library fills itself. No ads, ever — just your tunes." Style="{StaticResource MuurSecondaryText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                <Button Content="Add a music folder" Click="AddFolder_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
