<Page
    x:Class="MuurMusic.App.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="120" Height="120" CornerRadius="{StaticResource MuurRadiusCard}" Background="{ThemeResource MuurHighlightBrush}">
                <Image Stretch="UniformToFill">
                    <Image.Source>
                        <BitmapImage UriSource="{x:Bind ViewModel.ArtworkPath, Mode=OneWay, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="240" />
                    </Image.Source>
                </Image>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="{ThemeResource MuurHighlightBrush}" CornerRadius="4" Padding="5,1" Visibility="{x:Bind ViewModel.IsSmart, Mode=OneWay}">
                        <TextBlock Text="Smart" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MuurAccentTextBrush}" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Style="{StaticResource MuurAccentButton}" Click="Play_Click" AutomationProperties.Name="Play playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                </Button>
                <Button Click="EditSmart_Click" Visibility="{x:Bind ViewModel.IsSmart, Mode=OneWay}" AutomationProperties.Name="Edit smart rules"><TextBlock Text="Edit rules" /></Button>
                <Button Click="Export_Click" AutomationProperties.Name="Export playlist"><TextBlock Text="Export" /></Button>
            </StackPanel>
        </Grid>
        <ListView Grid.Row="1" x:Name="List"
                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  CanReorderItems="{x:Bind ViewModel.IsSmart, Mode=OneWay, Converter={StaticResource InverseBool}}"
                  AllowDrop="{x:Bind ViewModel.IsSmart, Mode=OneWay, Converter={StaticResource InverseBool}}"
                  DragItemsStarting="List_DragItemsStarting" DragItemsCompleted="List_DragItemsCompleted"
                  IsItemClickEnabled="True" ItemClick="List_ItemClick"
                  RightTapped="List_RightTapped"
                  SelectionMode="Extended" Padding="0,4,0,120"
                  AutomationProperties.Name="Playlist tracks">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vms:PlaylistEntryItemViewModel">
                    <Grid ColumnSpacing="10" Padding="0,2" Opacity="{x:Bind IsMissing, Mode=OneTime, Converter={StaticResource MissingOpacity}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind PositionDisplay}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="{ThemeResource MuurHighlightBrush}">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind ArtworkPath, Mode=OneTime, Converter={StaticResource PathOrDefaultArt}}" DecodePixelWidth="52" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Artist}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
