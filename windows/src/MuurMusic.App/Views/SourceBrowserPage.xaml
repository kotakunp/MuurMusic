<Page
    x:Class="MuurMusic.App.Views.SourceBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    xmlns:controls="using:MuurMusic.App.Controls"
    Background="Transparent">
    <Grid Margin="24,16,24,0" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MuurHeaderButton}" Click="Up_Click"
                    IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" AutomationProperties.Name="Up one folder">
                <FontIcon Glyph="&#xE74A;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" Style="{StaticResource MuurPageTitle}" />
                    <TextBlock Text="/" Style="{StaticResource MuurSecondaryText}" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentFolderName, Mode=OneWay}" FontSize="18" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Click="PlayAll_Click" AutomationProperties.Name="Play folder">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Play" /></StackPanel>
                </Button>
                <Button Style="{StaticResource MuurIconButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" Severity="Informational" Title="Offline mode"
                 Message="Showing cached listings only. Turn offline mode off in Settings for live browsing."
                 IsOpen="{x:Bind ViewModel.OfflineMode, Mode=OneWay}" IsClosable="False" />
        <Grid Grid.Row="2">
            <ListView x:Name="List"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      IsItemClickEnabled="True" ItemClick="List_ItemClick"
                      RightTapped="List_RightTapped"
                      SelectionMode="Single" Padding="0,4,0,120"
                      AutomationProperties.Name="Source items">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vms:BrowserItemViewModel">
                        <Grid ColumnSpacing="10" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource MuurAccentSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Subtitle}" Style="{StaticResource MuurSecondaryText}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <controls:PawLoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" PawSize="28" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="/Assets/offline.png" Width="240" />
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Page>
