<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MuurMusic.App.Converters">

    <conv:BoolToStringConverter x:Key="BoolToActiveTag" TrueValue="• playing" FalseValue="" />
    <conv:BoolToStringConverter x:Key="BoolToYesNo" TrueValue="Yes" FalseValue="No" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BytesConverter x:Key="Bytes" />
    <conv:DurationConverter x:Key="Duration" />
    <conv:DateTimeConverter x:Key="DateTime" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <conv:RatingStarsConverter x:Key="RatingStars" />
    <conv:ArtworkThumbConverter x:Key="ArtworkThumb" />
    <conv:PathOrDefaultArtConverter x:Key="PathOrDefaultArt" />
    <conv:MissingOpacityConverter x:Key="MissingOpacity" />

    <Style x:Key="MuurAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource MuurAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MuurBackgroundBrush}" />
    </Style>

    <Style x:Key="MuurHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource MuurTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>


    <Style x:Key="MuurCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuurElevatedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuurRadiusCard}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="MuurIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource MuurRadiusRow}" />
    </Style>

    <Style x:Key="MuurPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuurTextPrimaryBrush}" />
    </Style>

    <Style x:Key="MuurFlyoutStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource MuurElevatedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuurRadiusCard}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuurHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="MuurSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MuurTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</ResourceDictionary>
