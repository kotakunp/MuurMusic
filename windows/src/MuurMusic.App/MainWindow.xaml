<Window
    x:Class="MuurMusic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuurMusic.App.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource MuurBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/AppLogo.png" Width="22" Height="22" />
                <TextBlock Text="MuurMusic" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="320" HorizontalAlignment="Center"
                            PlaceholderText="Search songs, albums, artists&#x2026;"
                            QueryIcon="Find"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            TextChanged="SearchBox_TextChanged"
                            SuggestionChosen="SearchBox_SuggestionChosen"
                            AutomationProperties.Name="Search" />
        </Grid>

        <!-- Sidebar + content -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True"
                        OpenPaneLength="216"
                        Background="Transparent"
                        SelectionChanged="Nav_SelectionChanged"
                        AutomationProperties.Name="Main navigation">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Library" />
                <NavigationViewItem Content="Songs" Tag="songs"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="artists"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Album Artists" Tag="albumartists"><NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Genres" Tag="genres"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Composers" Tag="composers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Folders" Tag="folders"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Playlists &amp; you" />
                <NavigationViewItem Content="Playlists" Tag="playlists"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Bookmarks" Tag="bookmarks"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A4;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites"><NavigationViewItem.Icon><FontIcon Glyph="&#xE735;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Recently Added" Tag="recent"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Most Played" Tag="mostplayed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE1CE;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Music everywhere" />
                <NavigationViewItem Content="Sources" Tag="sources"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Files" Tag="files"><NavigationViewItem.Icon><FontIcon Glyph="&#xE838;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Now playing" />
                <NavigationViewItem Content="Now Playing" Tag="nowplaying"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Visualizer" Tag="visualizer"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Equalizer" Tag="eq"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Effects" Tag="effects"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B8;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="DSP Chain" Tag="dsp"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9CE;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>

        <!-- Transport bar -->
        <controls:MiniPlayer x:Name="PlayerBar" Grid.Row="2" />

        <!-- In-app notifications -->
        <InfoBar x:Name="NotificationBar" Grid.Row="1" Grid.RowSpan="2"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 Margin="0,0,16,16" MaxWidth="420"
                 IsOpen="False" IsClosable="True" Closed="NotificationBar_Closed" />
    </Grid>
</Window>
