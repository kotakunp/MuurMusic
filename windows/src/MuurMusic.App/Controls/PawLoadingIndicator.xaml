<UserControl
    x:Class="MuurMusic.App.Controls.PawLoadingIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <!-- Three paw prints stepping in sequence while work is in flight. -->
    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="Paw1" Text="&#x1F43E;" FontSize="{x:Bind PawSize, Mode=OneWay}" Foreground="{ThemeResource MuurAccentBrush}" Opacity="0.25" />
        <TextBlock x:Name="Paw2" Text="&#x1F43E;" FontSize="{x:Bind PawSize, Mode=OneWay}" Foreground="{ThemeResource MuurAccentBrush}" Opacity="0.25" />
        <TextBlock x:Name="Paw3" Text="&#x1F43E;" FontSize="{x:Bind PawSize, Mode=OneWay}" Foreground="{ThemeResource MuurAccentBrush}" Opacity="0.25" />
    </StackPanel>
</UserControl>
