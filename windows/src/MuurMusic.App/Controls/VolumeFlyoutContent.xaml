<UserControl
    x:Class="MuurMusic.App.Controls.VolumeFlyoutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320">
    <StackPanel Spacing="10">
        <TextBlock Text="Volume &amp; output" FontSize="16" FontWeight="SemiBold" />
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource MuurIconButtonStyle}" Click="Mute_Click" AutomationProperties.Name="Mute" VerticalAlignment="Center">
                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="16" />
            </Button>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"
                    VerticalAlignment="Center" AutomationProperties.Name="Volume" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VolumePercentText, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" Width="34" />
        </Grid>
        <TextBlock Text="Output device" FontWeight="SemiBold" FontSize="13" />
        <ListView x:Name="DeviceList" MaxHeight="200" SelectionMode="Single" ItemClick="DeviceList_ItemClick" IsItemClickEnabled="True" AutomationProperties.Name="Output devices">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7F5;" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FriendlyName}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToActiveTag}}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="{x:Bind ViewModel.ExclusiveLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleExclusiveCommand}" AutomationProperties.Name="Toggle exclusive mode" />
        <TextBlock Text="Exclusive mode gives MuurMusic the device for bit-perfect playback (rate follows the song)." Style="{StaticResource MuurSecondaryText}" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
