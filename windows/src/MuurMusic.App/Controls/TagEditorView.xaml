<UserControl
    x:Class="MuurMusic.App.Controls.TagEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="480">
    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="10">
            <TextBlock x:Name="BatchNote" Style="{StaticResource MuurSecondaryText}" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="120" Height="120" CornerRadius="{StaticResource MuurRadiusCard}" Background="{ThemeResource MuurHighlightBrush}">
                    <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Replace artwork&#x2026;" Click="PickArtwork_Click" AutomationProperties.Name="Replace artwork" />
                    <Button Content="Remove artwork" Click="RemoveArtwork_Click" AutomationProperties.Name="Remove artwork" />
                    <TextBlock x:Name="ArtworkNote" Style="{StaticResource MuurSecondaryText}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="TitleBox" Header="Title" />
            <TextBox x:Name="ArtistBox" Header="Artist" />
            <TextBox x:Name="AlbumBox" Header="Album" />
            <TextBox x:Name="AlbumArtistBox" Header="Album artist" />
            <TextBox x:Name="GenreBox" Header="Genre" />
            <TextBox x:Name="ComposerBox" Header="Composer" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="YearBox" Header="Year" InputScope="Number" />
                <TextBox Grid.Column="1" x:Name="TrackNumberBox" Header="Track #" InputScope="Number" />
                <TextBox Grid.Column="2" x:Name="TrackTotalBox" Header="of" InputScope="Number" />
            </Grid>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DiscNumberBox" Header="Disc #" InputScope="Number" />
                <TextBox Grid.Column="1" x:Name="DiscTotalBox" Header="of" InputScope="Number" />
                <TextBox Grid.Column="2" x:Name="BpmBox" Header="BPM" InputScope="Number" />
            </Grid>
            <TextBox x:Name="CommentBox" Header="Comment" />
            <TextBox x:Name="LyricsBox" Header="Lyrics" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

            <Border Background="{ThemeResource MuurHighlightBrush}" CornerRadius="{StaticResource MuurRadiusRow}" Padding="10">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" VerticalAlignment="Center" Foreground="{ThemeResource MuurAccentSecondaryBrush}" />
                        <TextBlock Text="MusicBrainz" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MbStatus" Style="{StaticResource MuurSecondaryText}" FontSize="12" TextWrapping="Wrap" Text="Look up this recording on MusicBrainz to fill tags and IDs automatically." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MbSearchButton" Content="Look up" Click="MbSearch_Click" AutomationProperties.Name="Look up on MusicBrainz" />
                        <Button x:Name="MbAutoButton" Content="Auto-match" Click="MbAuto_Click" AutomationProperties.Name="MusicBrainz auto-match" />
                        <controls:PawLoadingIndicator x:Name="MbPaws" PawSize="12" IsActive="False" xmlns:controls="using:MuurMusic.App.Controls" />
                    </StackPanel>
                    <ListView x:Name="MbResults" MaxHeight="180" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="MbResults_ItemClick" AutomationProperties.Name="MusicBrainz results">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,3">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MuurSecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
