<UserControl
    x:Class="MuurMusic.App.Controls.QueueFlyoutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="using:MuurMusic.App.ViewModels"
    Width="400">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Play queue" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource MuurSecondaryText}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" Command="{x:Bind ViewModel.ClearQueueCommand}" AutomationProperties.Name="Clear queue" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PlaylistNameBox" PlaceholderText="Save queue as playlist&#x2026;" KeyDown="PlaylistNameBox_KeyDown" />
            <Button Grid.Column="1" Content="Save" Click="SavePlaylist_Click" AutomationProperties.Name="Save queue as playlist" />
        </Grid>

        <ListView x:Name="QueueList" Grid.Row="2" MaxHeight="420" MinHeight="120"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  SelectionMode="None" CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                  DragItemsStarting="QueueList_DragItemsStarting" DragItemsCompleted="QueueList_DragItemsCompleted"
                  ItemClick="QueueList_ItemClick" IsItemClickEnabled="True"
                  AutomationProperties.Name="Play queue">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vms:QueueEntryItemViewModel">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="2" Background="{ThemeResource MuurAccentBrush}"
                                Visibility="{x:Bind IsCurrent, Mode=OneWay}" Margin="0,2" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" MaxLines="1" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Artist}" Style="{StaticResource MuurSecondaryText}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Duration}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Style="{StaticResource MuurIconButtonStyle}" Click="RemoveEntry_Click"
                                AutomationProperties.Name="Remove from queue" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Text="Drag tracks to reorder. Click a track to jump to it." Style="{StaticResource MuurSecondaryText}" FontSize="11" />
    </Grid>
</UserControl>
