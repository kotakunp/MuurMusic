<UserControl
    x:Class="MuurMusic.App.Controls.TrackRowsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MuurMusic.Core.Models">
    <ListView x:Name="List"
              SelectionMode="Extended"
              IsItemClickEnabled="False"
              DoubleTapped="List_DoubleTapped"
              RightTapped="List_RightTapped"
              Padding="0,4,0,16"
              AutomationProperties.Name="Tracks">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:Track">
                <Grid ColumnSpacing="8" Padding="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="5" Background="{ThemeResource MuurHighlightBrush}" VerticalAlignment="Center">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind ArtworkHash, Mode=OneTime, Converter={StaticResource ArtworkThumb}, ConverterParameter=64}" DecodePixelWidth="56" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{ThemeResource MuurAccentBrush}" Visibility="{x:Bind Favorite, Mode=OneTime}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind DisplayArtist}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Grid.Column="3" Text="{x:Bind DisplayAlbum}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Grid.Column="4" Text="{x:Bind DurationMs, Converter={StaticResource Duration}}" Style="{StaticResource MuurSecondaryText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{x:Bind Rating, Converter={StaticResource RatingStars}}" VerticalAlignment="Center" FontSize="10" Foreground="{ThemeResource MuurAccentTextBrush}" />
                    <Border Grid.Column="6" Background="{ThemeResource MuurHighlightBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind QualityBadge}" FontSize="10" Foreground="{ThemeResource MuurAccentTextBrush}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
