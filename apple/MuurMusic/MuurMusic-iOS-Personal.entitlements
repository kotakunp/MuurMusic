<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used when MUUR_PERSONAL_TEAM = YES (Signing.xcconfig): free Personal Teams
	     cannot sign Multicast Networking or CarPlay, only the App Group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(MUUR_APP_GROUP)</string>
	</array>
</dict>
</plist>
