<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.muur.music</string>
	</array>
	<!-- SSDP / Bonjour discovery of DLNA & NAS devices. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
	<!-- CarPlay audio app. This entitlement requires Apple's CarPlay capability
	     on the provisioning profile. It compiles and runs in CI without it
	     (CI builds with CODE_SIGNING_ALLOWED=NO). For personal/free accounts,
	     DELETE these two lines before signing — see apple/BUILD.md. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
