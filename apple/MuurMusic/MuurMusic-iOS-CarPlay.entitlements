<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(MUUR_APP_GROUP)</string>
	</array>
	<!-- SSDP / Bonjour discovery of DLNA & NAS devices. -->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
	<!-- CarPlay audio app. Used when MUUR_CARPLAY = YES (Signing.xcconfig); the
	     provisioning profile must carry Apple's CarPlay audio entitlement. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
